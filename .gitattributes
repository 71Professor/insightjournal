# Moodle requires LF line endings in source files. Enforce LF on checkout and
# normalise on commit, regardless of the contributor's platform.
* text=auto eol=lf

# Binary assets must never be line-ending converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary

# Development-only files, excluded from release ZIPs and GitHub source
# archives so the installable plugin folder contains only runtime files.
/docs                  export-ignore
/phpstan.neon          export-ignore
/phpstan-tests.neon    export-ignore
/phpstan-bootstrap.php export-ignore
/.github               export-ignore
/.gitattributes        export-ignore
/.gitignore            export-ignore
