{{!
    @template mod_insightjournal/entry_card

    Card showing a single insight journal entry within a summary listing.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * activityname - Name of the activity the entry belongs to.
    * prompt - Pre-formatted prompt HTML (rendered via triple braces).
    * promptstyle - Inline CSS for the prompt box background colour, or '' for none.
    * private - Whether this activity's entries are currently private to the
      viewer (the site or per-activity "entries visible to trainer" setting
      resolves to off for someone else's entry). When true, a notice is shown
      instead of the response; the prompt itself always stays visible.
    * hasresponse - Whether the user has entered a response (always false when private).
    * response - The user's pre-formatted response HTML (rendered via triple braces), or empty if none.
    * timemodified - Localised last modified date, or empty if none/private.
    * canedit - Whether the viewer owns this entry and may still submit to it. When
      true, an Edit link back to the activity is shown.
    * editurl - URL to the activity's view page, used by the Edit link. Only
      meaningful when canedit is true.

    Example context (json):
    {
        "activityname": "Week 1 reflection",
        "prompt": "<p>What did you learn today?</p>",
        "promptstyle": "",
        "private": false,
        "hasresponse": true,
        "response": "<p>Today I learned about Mustache templates.</p>",
        "timemodified": "1 January 2026, 10:00 AM",
        "canedit": true,
        "editurl": "https://example.com/mod/insightjournal/view.php?id=5"
    }
}}
<div class="card mb-3">
    <div class="card-header"><strong>{{activityname}}</strong></div>
    <div class="card-body">
        {{! prompt and response are pre-sanitised via format_text() in PHP – triple braces intentional }}
        <div class="insightjournal-prompt mb-2"{{#promptstyle}} style="{{promptstyle}}"{{/promptstyle}}>{{{prompt}}}</div>
        {{#private}}<div class="alert alert-info mb-0">{{#str}}entriesprivatenotice, mod_insightjournal{{/str}}</div>{{/private}}
        {{^private}}
            {{#hasresponse}}<div class="border rounded p-3 bg-light insightjournal-response-text">{{{response}}}</div>{{/hasresponse}}
            {{^hasresponse}}<div class="text-muted font-italic">{{#str}}noresponse, mod_insightjournal{{/str}}</div>{{/hasresponse}}
            {{#timemodified}}<div class="small text-muted mt-2">{{timemodified}}</div>{{/timemodified}}
        {{/private}}
        {{#canedit}}<a href="{{editurl}}" class="btn btn-secondary btn-sm mt-2">{{#str}}gotoentry, mod_insightjournal{{/str}}</a>{{/canedit}}
    </div>
</div>
